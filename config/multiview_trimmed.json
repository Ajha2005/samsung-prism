{
  "name": "multiview-trimmed",
  "backend": {
    "kind": "sentence_transformer",
    "model_name": "sentence-transformers/all-MiniLM-L6-v2",
    "normalize": true,
    "batch_size": 32,
    "device": "cpu",
    "max_seq_length": 256,
    "trust_remote_code": false
  },
  "query": { "normalize": true, "extract_keywords": true, "classify_type": true, "hyde_enabled": false },
  "snippet": {
    "normalize": true,
    "multiview_enabled": true,
    "view_weights": { "raw": 1.0, "ast": 0.0, "identifiers": 0.5 },
    "max_chars": 4000,
    "chunk_overlap": 200
  },
  "scoring": { "hybrid_enabled": false },
  "versioning": { "enabled": false }
}
