{
  "name": "mpnet-512",
  "backend": {
    "kind": "sentence_transformer",
    "model_name": "sentence-transformers/all-mpnet-base-v2",
    "normalize": true,
    "batch_size": 16,
    "device": "cpu",
    "max_seq_length": 512
  },
  "query": { "normalize": true, "extract_keywords": true, "classify_type": true, "hyde_enabled": false },
  "snippet": { "normalize": true, "multiview_enabled": false },
  "scoring": { "hybrid_enabled": false },
  "versioning": { "enabled": false }
}
